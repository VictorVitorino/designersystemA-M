# Desenvolvimento local (copie para platform/.env). Banco: `node tools/local-db.js up` (Postgres local). Login falso: tools/fake-gotrue.js.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://app_api:<SENHA_DO_APP_API>@127.0.0.1:5432/canteiro_dev
DATABASE_SSL=disable
SUPABASE_URL=http://127.0.0.1:4310
SUPABASE_ANON_KEY=chave-anon-local-de-teste
SUPABASE_SERVICE_ROLE_KEY=chave-servico-local-de-teste
SUPABASE_JWT_SECRET=segredo-jwt-local-de-teste-com-32-bytes-ou-mais
GOTRUE_FAKE=1
ALLOW_SERVICE_KEY_IN_API=1
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/objects
CSRF_SECRET=segredo-csrf-local-com-pelo-menos-32-caracteres
# Ferramentas (migrate, backup local, GC)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/canteiro_dev
DATABASE_OPS_URL=postgres://app_ops:<SENHA_DO_APP_OPS>@127.0.0.1:5432/canteiro_dev
APP_API_DB_PASSWORD=<senha-local-1>
APP_OPS_DB_PASSWORD=<senha-local-2>

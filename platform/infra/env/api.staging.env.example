# Variáveis da API em STAGING — cadastre na Vercel: Project → Settings → Environment Variables → ambiente personalizado "staging" (Vercel Pro).
# Marque como "Sensitive" tudo que for segredo (chaves, senhas, URL do banco). NÃO existe arquivo .env em staging/produção.
APP_ENV=staging
APP_ORIGIN=https://staging.canteiro.<seu-dominio>
DATABASE_URL=postgres://app_api.<ref-staging>:<SENHA_DO_APP_API>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=require
DB_POOL_MAX=3
SUPABASE_URL=https://<ref-staging>.supabase.co
SUPABASE_ANON_KEY=<anon-staging>
SUPABASE_SERVICE_ROLE_KEY=<service-role-staging>
SUPABASE_JWKS_URL=https://<ref-staging>.supabase.co/auth/v1/.well-known/jwks.json
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ref-staging>.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_BUCKET=canteiro-arquivos
S3_ACCESS_KEY_ID=<chave-s3-staging>
S3_SECRET_ACCESS_KEY=<segredo-s3-staging>
S3_FORCE_PATH_STYLE=true
CSRF_SECRET=<48-bytes-aleatorios-exclusivos-de-staging>
INVITE_ALLOWED_DOMAINS=<dominio-da-empresa>
TRUST_PROXY=1
# Opcional: limite por IP nas rotas autenticadas = limite por usuário × fator (padrão 25). Aumente se > ~200 pessoas usarem a plataforma atrás de um só NAT.
# RATE_IP_MULTIPLIER=25
LOG_LEVEL=info
# SENTRY_DSN=<opcional>
# NÃO CADASTRAR NA VERCEL: DATABASE_ADMIN_URL, DATABASE_OPS_URL, APP_API_DB_PASSWORD, APP_OPS_DB_PASSWORD, BACKUP_*, GOTRUE_FAKE, TEST_DATABASE_ADMIN_URL

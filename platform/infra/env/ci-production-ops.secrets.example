# GitHub → Settings → Environments → "production-ops" (SEM revisores; restrinja à branch main) — usado por backup.yml e maintenance.yml (cron).
DATABASE_ADMIN_URL=postgres://postgres:<SENHA>@db.<ref-producao>.supabase.co:5432/postgres?sslmode=require
DATABASE_OPS_URL=postgres://app_ops.<ref-producao>:<SENHA_DO_APP_OPS>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
S3_ENDPOINT=https://<ref-producao>.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_BUCKET=canteiro-arquivos
S3_ACCESS_KEY_ID=<chave-s3-producao>
S3_SECRET_ACCESS_KEY=<segredo-s3-producao>
BACKUP_TARGET=s3://<bucket-de-backup>/producao
BACKUP_ENCRYPTION_KEY=<32-bytes-base64>
BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=<chave-de-escrita-do-bucket-de-backup>
BACKUP_S3_SECRET_ACCESS_KEY=<segredo-de-escrita-do-bucket-de-backup>
# Variables (opcionais): WARN_DB_GB=6   WARN_STORAGE_GB=800   PG_CLIENT_MAJOR=17

# GitHub → Settings → Environments → "production-ops" (Deployment branches and tags: main E tags v*; sem revisores).
# TODOS os segredos de produção, num lugar só: Deploy produção (publicação), Backup, Manutenção, Ensaio de restauração e os assistentes.
# Lista explicada, com a TELA de onde copiar cada valor: docs/CHAVES.md.
# ---- Environment variables (1) ----
SUPABASE_PROJECT_REF=<project-id-do-canteiro-prod-20-letras>
# ---- Environment secrets (12) ----
SUPABASE_DB_PASSWORD=<senha-do-banco-do-canteiro-prod>
SUPABASE_ANON_KEY=sb_publishable_<...>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>
S3_ACCESS_KEY_ID=<access-key-id-do-storage-producao>
S3_SECRET_ACCESS_KEY=<secret-access-key-do-storage-producao>
APP_API_DB_PASSWORD=<40-letras-e-numeros-do-cofre>
APP_OPS_DB_PASSWORD=<40-letras-e-numeros-do-cofre-outra>
RESEND_API_KEY=re_<...>
VERCEL_TOKEN=<token-da-vercel-escopo-canteiro-am>
BACKUP_S3_ACCESS_KEY_ID=<access-key-id-do-token-R2-de-ESCRITA>
BACKUP_S3_SECRET_ACCESS_KEY=<secret-access-key-do-token-R2-de-ESCRITA>
BACKUP_ENCRYPTION_KEY=<43-letras-e-numeros-do-cofre>
# Variables do REPOSITÓRIO (não deste ambiente): R2_ACCOUNT_ID, PRODUCTION_URL, STAGING_URL; interruptores PRODUCTION_ENABLED e BACKUP_ENABLED;
# opcionais: WARN_DB_GB=6  WARN_STORAGE_GB=800  PG_CLIENT_MAJOR=17  BACKUP_INCLUDE_AUTH=1 (padrão)

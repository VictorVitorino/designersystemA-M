# GitHub → Settings → Environments → "monitoring" — usado só por uptime.yml (frescor do backup). Credencial SOMENTE LEITURA do bucket de backup.
# Não precisa (e não deve ter) a BACKUP_ENCRYPTION_KEY: o manifesto é lido sem abrir o backup.
BACKUP_TARGET=s3://<bucket-de-backup>/producao
BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=<chave-SOMENTE-LEITURA-do-bucket-de-backup>
BACKUP_S3_SECRET_ACCESS_KEY=<segredo-SOMENTE-LEITURA-do-bucket-de-backup>

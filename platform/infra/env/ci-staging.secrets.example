# GitHub → Settings → Environments → "staging" (Deployment branches: main). Lista explicada, com a TELA de onde copiar cada valor: docs/CHAVES.md.
# Só as chaves mínimas: o resto (URLs do banco, endpoints, bucket) é montado por tools/chaves.js.
# ---- Environment variables (1) ----
SUPABASE_PROJECT_REF=<project-id-do-canteiro-staging-20-letras>
# ---- Environment secrets (9) ----
SUPABASE_DB_PASSWORD=<senha-do-banco-do-canteiro-staging>
SUPABASE_ANON_KEY=sb_publishable_<...>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>
S3_ACCESS_KEY_ID=<access-key-id-do-storage-staging>
S3_SECRET_ACCESS_KEY=<secret-access-key-do-storage-staging>
APP_API_DB_PASSWORD=<40-letras-e-numeros-do-cofre>
APP_OPS_DB_PASSWORD=<40-letras-e-numeros-do-cofre-outra>
RESEND_API_KEY=re_<...>
VERCEL_TOKEN=<token-da-vercel-escopo-canteiro-am>
# opcionais (docs/CHAVES.md §Opcionais): SUPABASE_REGION, SUPABASE_POOLER_HOST, SSO_ENABLED, SSO_DOMAINS, STORAGE_QUOTA_USER_MB, CSRF_SECRET
# backup do staging só com a variável do repositório STAGING_BACKUP=true: BACKUP_S3_ACCESS_KEY_ID, BACKUP_S3_SECRET_ACCESS_KEY, BACKUP_ENCRYPTION_KEY

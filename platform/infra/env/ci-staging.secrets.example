# GitHub → Settings → Environments → "staging" → Environment secrets / variables.   (lista completa e explicada em docs/CONFIGURACAO.md §Secrets)
# ---- Secrets (valores sigilosos) ----
VERCEL_TOKEN=<token-da-vercel-com-escopo-so-deste-time>
DATABASE_ADMIN_URL=postgres://postgres:<SENHA>@db.<ref-staging>.supabase.co:5432/postgres?sslmode=require
APP_API_DB_PASSWORD=<senha-do-papel-app_api-staging>
APP_OPS_DB_PASSWORD=<senha-do-papel-app_ops-staging>
SUPABASE_URL=https://<ref-staging>.supabase.co
SUPABASE_ANON_KEY=<anon-staging>
S3_ENDPOINT=https://<ref-staging>.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_BUCKET=canteiro-arquivos-staging
S3_ACCESS_KEY_ID=<chave-s3-staging>
S3_SECRET_ACCESS_KEY=<segredo-s3-staging>
# opcionais (somente se STAGING_BACKUP=true): BACKUP_TARGET, BACKUP_ENCRYPTION_KEY, BACKUP_S3_ENDPOINT, BACKUP_S3_REGION, BACKUP_S3_ACCESS_KEY_ID, BACKUP_S3_SECRET_ACCESS_KEY
# ---- Variables (não sigilosas): cadastre como VARIÁVEIS DO REPOSITÓRIO (Settings → Secrets and variables → Actions → Variables) ----
# STAGING_URL=https://staging.canteiro.<seu-dominio>     STAGING_HOST=staging.canteiro.<seu-dominio>     STAGING_BACKUP=false

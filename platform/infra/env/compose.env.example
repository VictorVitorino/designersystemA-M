# Autohospedagem (docker-compose.yml): copie para platform/.env (NÃO versione). Todas as senhas: longas, aleatórias e diferentes.
CANTEIRO_HOST=canteiro.<seu-dominio>
ACME_EMAIL=<ti@seu-dominio>
POSTGRES_PASSWORD=<senha-longa-1>
APP_API_DB_PASSWORD=<senha-longa-2>
APP_OPS_DB_PASSWORD=<senha-longa-3>
CSRF_SECRET=<48-bytes-aleatorios>
INVITE_ALLOWED_DOMAINS=<seu-dominio>
# Login (GoTrue): no perfil "completo" use http://gotrue:9999; chaves geradas por você com o mesmo segredo JWT
AUTH_URL=http://gotrue:9999
AUTH_JWT_SECRET=<segredo-jwt-32-bytes-ou-mais>
AUTH_ANON_KEY=<jwt-anon-assinado-com-o-segredo>
AUTH_SERVICE_KEY=<jwt-service-assinado-com-o-segredo>
GOTRUE_IMAGE=supabase/gotrue:<versao-fixa>
GOTRUE_DB_PASSWORD=<senha-longa-4>
SMTP_HOST=<smtp.seu-provedor.com>
SMTP_PORT=587
SMTP_USER=<usuario-smtp>
SMTP_PASS=<senha-smtp>
SMTP_FROM=nao-responda@<seu-dominio>
# Arquivos (MinIO no perfil "completo" ou qualquer S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=<minio-root-user-ou-chave-de-servico>
S3_SECRET_ACCESS_KEY=<minio-root-password-ou-segredo>
S3_BUCKET=canteiro-arquivos
MINIO_IMAGE=minio/minio:<versao-fixa>
MINIO_ROOT_USER=<usuario-admin-minio>
MINIO_ROOT_PASSWORD=<senha-longa-5>

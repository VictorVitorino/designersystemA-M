# Variáveis da API em PRODUÇÃO na Vercel (ambiente "Production"). QUEM GRAVA é o workflow "Configurar Vercel" (tools/vercel-setup.js),
# a partir das chaves do GitHub (docs/CHAVES.md), com os segredos como "Sensitive". Este arquivo é a referência (e o plano B manual). NÃO existe .env aqui.
APP_ENV=production
APP_ORIGIN=https://canteiro.<seu-dominio>
DATABASE_URL=postgres://app_api.<ref-producao>:<SENHA_DO_APP_API>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=require
DB_POOL_MAX=3
SUPABASE_URL=https://<ref-producao>.supabase.co
SUPABASE_ANON_KEY=<anon-producao>
SUPABASE_SERVICE_ROLE_KEY=<service-role-producao>
SUPABASE_JWKS_URL=https://<ref-producao>.supabase.co/auth/v1/.well-known/jwks.json
# Opcional: login corporativo (SSO SAML). Ligado, exige os domínios de e-mail (infra/supabase/sso-saml.md).
# SSO_ENABLED=true
# SSO_DOMAINS=<dominio-da-empresa>
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ref-producao>.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_BUCKET=canteiro-arquivos
S3_ACCESS_KEY_ID=<chave-s3-producao>
S3_SECRET_ACCESS_KEY=<segredo-s3-producao>
S3_FORCE_PATH_STYLE=true
# Opcional: cota de armazenamento por pessoa em MB (0 = desligada). Ex.: 20480 = 20 GB por pessoa (veja docs/arquivos-e-armazenamento.md §8).
# STORAGE_QUOTA_USER_MB=0
CSRF_SECRET=<48-bytes-aleatorios-exclusivos-de-producao>
INVITE_ALLOWED_DOMAINS=<dominio-da-empresa>
TRUST_PROXY=1
# Opcional: limite por IP nas rotas autenticadas = limite por usuário × fator (padrão 25). Aumente se > ~200 pessoas usarem a plataforma atrás de um só NAT.
# RATE_IP_MULTIPLIER=25
LOG_LEVEL=info
# SENTRY_DSN=<opcional>
# NÃO CADASTRAR NA VERCEL: DATABASE_ADMIN_URL, DATABASE_OPS_URL, APP_API_DB_PASSWORD, APP_OPS_DB_PASSWORD, BACKUP_*, GOTRUE_FAKE, TEST_DATABASE_ADMIN_URL

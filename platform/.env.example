# =====================================================================================================================
# Canteiro online — modelo de variáveis de ambiente.   COPIE para .env (que NUNCA vai para o git) e preencha.
# Em staging/produção NÃO use arquivo: cadastre as variáveis na Vercel (API) e nos "Environments" do GitHub (ferramentas).
# Valores abaixo são PLACEHOLDERS. Contrato completo: docs/API.md §9 · passo a passo: docs/CONFIGURACAO.md.
# =====================================================================================================================

# ╔═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════╗
# ║ PARTE 1 — VARIÁVEIS DA API  (ficam na Vercel / no servidor que atende o navegador)                                ║
# ╚═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝

# --- Ambiente e endereço ---------------------------------------------------------------------------------------------
# local | test | staging | production. Em staging/production a API exige HTTPS, cookies __Host- e recusa configuração insegura.
APP_ENV=local
# Origem pública EXATA (sem barra no final). Usada em CSRF, CORS e nos links dos e-mails.
APP_ORIGIN=http://localhost:3000
# Porta do servidor local/contêiner (na Vercel é ignorada).
PORT=3000

# --- Banco de dados (papel app_api: sem privilégio em tabelas) ----------------------------------------------------------
# Supabase: use o POOLER em modo transação (porta 6543), usuário postgres.<ref> trocado por app_api.<ref>, senha = APP_API_DB_PASSWORD.
DATABASE_URL=postgres://app_api:<SENHA_DO_APP_API>@127.0.0.1:5432/canteiro_dev
# require (padrão em staging/produção) | disable (somente local)
DATABASE_SSL=disable
# Conexões por instância (serverless: mantenha pequeno, 3 a 5)
DB_POOL_MAX=5

# --- Autenticação (Supabase Auth / GoTrue) ----------------------------------------------------------------------------
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_ANON_KEY=<chave-anon-ou-publishable>
# SÓ no servidor. Necessária para convidar usuários. NUNCA em variável com prefixo público (NEXT_PUBLIC_, VITE_…).
SUPABASE_SERVICE_ROLE_KEY=<chave-service-role-ou-secret>
# Verificação do token: prefira as chaves assimétricas (JWKS). O segredo HS256 é o modo legado.
SUPABASE_JWKS_URL=https://<ref-do-projeto>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=<somente-se-nao-usar-JWKS>
# Somente test/local: aponta SUPABASE_URL para tools/fake-gotrue.js. PROIBIDO em staging/produção.
GOTRUE_FAKE=0

# --- Arquivos (armazenamento de objetos) ---------------------------------------------------------------------------------
# local (pasta; só desenvolvimento) | s3 (Supabase Storage S3, Cloudflare R2, AWS S3, MinIO…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/objects
# Driver s3 — bucket PRIVADO, chave só com acesso a este bucket
S3_ENDPOINT=https://<ref-do-projeto>.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_BUCKET=canteiro-arquivos
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
S3_FORCE_PATH_STYLE=true
# Cota de armazenamento POR PESSOA em MB (0 = desligada, o padrão). Vale ao enviar arquivo NOVO; reenviar o que já existe (deduplicação) nunca é barrado.
# Estourou → 413 quota_exceeded. O admin vê o espaço de cada pessoa em Administração › Usuários (storageBytes). Ex.: 20480 = 20 GB por pessoa.
STORAGE_QUOTA_USER_MB=0

# --- Segurança e política ---------------------------------------------------------------------------------------------------
# ≥ 32 bytes aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
CSRF_SECRET=<gere-48-bytes-aleatorios>
# Opcional: só aceita convites desses domínios (separados por vírgula)
INVITE_ALLOWED_DOMAINS=
# Atrás da Vercel/Cloudflare: confia em x-forwarded-for / x-real-ip
TRUST_PROXY=1
# Limites de taxa por IP nas rotas autenticadas = limite por usuário × este fator (padrão 25; mínimo 5). Um escritório atrás de um só NAT não se bloqueia.
# RATE_IP_MULTIPLIER=25

# --- Observabilidade ---------------------------------------------------------------------------------------------------------
LOG_LEVEL=info
# Opcional (Sentry via integração da Vercel). Não é um segredo crítico, mas não publique.
SENTRY_DSN=
# Rótulo da versão publicada (a Vercel define sozinha quando usado VERCEL_GIT_COMMIT_SHA)
RELEASE=dev
# Pasta dos arquivos estáticos quando a API serve o site (contêiner/dev). Na Vercel o site sai da CDN.
PUBLIC_DIR=./dist/public
# Teto do corpo de salvar/criar apresentação, em BYTES. Padrão: 13 MiB (13631488) em servidor Node; 4 MiB (4194304) na Vercel, cuja função não
# recebe nem devolve mais que 4,5 MB. Só defina para mudar o padrão.
# MAX_JSON_BYTES=13631488
# A própria Vercel define VERCEL=1 (não cadastre): com ela a API usa os limites acima (4 MiB por salvamento; arquivos > 4 MiB saem por URL assinada).
# VERCEL=1

# ╔═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════╗
# ║ PARTE 2 — SOMENTE FERRAMENTAS / CI  (NUNCA configure estas na Vercel nem no processo da API)                      ║
# ║ A API se recusa a iniciar em staging/produção se encontrar DATABASE_ADMIN_URL ou DATABASE_OPS_URL.                  ║
# ╚═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝

# --- Banco: operação ------------------------------------------------------------------------------------------------------------
# Dono do banco (Supabase: usuário postgres, conexão DIRETA porta 5432, com ?sslmode=require). Usado por migrate, backup, restore.
DATABASE_ADMIN_URL=postgres://postgres:<SENHA_DO_POSTGRES>@127.0.0.1:5432/canteiro_dev
# Papel app_ops (jobs de manutenção, GC, seed). Em produção: conexão direta ou pooler em modo sessão.
DATABASE_OPS_URL=postgres://app_ops:<SENHA_DO_APP_OPS>@127.0.0.1:5432/canteiro_dev
# Senhas que o migrate define para os papéis app_api e app_ops (gere senhas longas e diferentes)
APP_API_DB_PASSWORD=<senha-longa-aleatoria-1>
APP_OPS_DB_PASSWORD=<senha-longa-aleatoria-2>
# Pasta dos binários pg_dump/pg_restore quando a versão do PATH não for a do servidor (ex.: /usr/lib/postgresql/17/bin)
PG_BIN_DIR=

# --- Backup (credenciais e chave SEPARADAS das do armazenamento principal) ---------------------------------------------------------------
# Destino: file:///pasta/absoluta  |  s3://bucket-de-backup/prefixo   (bucket em OUTRA conta/provedor)
BACKUP_TARGET=file:///var/backups/canteiro
# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". GUARDE NO COFRE DE SENHAS: sem ela o backup não abre.
BACKUP_ENCRYPTION_KEY=<32-bytes-base64>
# Chaves antigas (rotação), separadas por vírgula. Só para ABRIR backups feitos antes da troca.
BACKUP_ENCRYPTION_KEYS_OLD=
# Rótulo do ambiente no nome do backup (padrão: APP_ENV)
BACKUP_ENV_NAME=
# Quando BACKUP_TARGET é s3://…
BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=<access-key-id-do-bucket-de-backup>
BACKUP_S3_SECRET_ACCESS_KEY=<secret-do-bucket-de-backup>
BACKUP_S3_FORCE_PATH_STYLE=true

# --- Testes (somente máquina de desenvolvimento/CI; os testes APAGAM o schema app deste banco) -----------------------------------------------
TEST_DATABASE_ADMIN_URL=postgres://postgres:<SENHA_DO_POSTGRES>@127.0.0.1:5432/canteiro_test
